#!/bin/bash
# =============================================================================
# Benchmark configuration template for chewcall paper
# Copy this file to config.sh and edit the paths for your environment.
# =============================================================================

# --- Tool paths ---
# Path to the compiled chewcall binary
CHEWCALL="${CHEWCALL:-./target/release/chewcall}"

# Path to parasail shared library directory (containing libparasail.so)
PARASAIL_LIB="${PARASAIL_LIB:-$HOME/parasail/build}"

# --- Conda environments ---
# Conda environment with chewBBACA v3.5.3 installed
CONDA_V3="${CONDA_V3:-chewbbaca_v3}"

# Conda environment with chewBBACA v2.8.5 installed
CONDA_V2="${CONDA_V2:-chewbbaca_v2}"

# --- Data directories ---
# Root directory for BeONE benchmark data (genomes, schemas, CDS)
# Expected structure: $BEONE_DATA/{lm,se,ec,cj}/{genomes,schema,cds}/
BEONE_DATA="${BEONE_DATA:-./data/beone}"

# Root directory for benchmark outputs
BENCH_DIR="${BENCH_DIR:-./benchmarks}"

# --- Benchmark parameters ---
CPU="${CPU:-8}"
REPS="${REPS:-3}"

# --- Derived paths (usually no need to change) ---
TIMING_LOG="$BENCH_DIR/timing.tsv"
MASTER_LOG="$BENCH_DIR/benchmark.log"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
